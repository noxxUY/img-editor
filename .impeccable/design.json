      "html": "<div class=\"ds-cart\"><span class=\"ds-cart-name\">gta3.img</span><span class=\"ds-cart-meta\">v2 · San Andreas · 16,384</span><span class=\"ds-cart-dirty\"><span class=\"ds-dot\"></span>unsaved</span></div>",
      "css": ".ds-cart{display:inline-flex;align-items:center;gap:10px;height:32px;padding:0 12px 0 10px;border:1px solid var(--line-strong,#3a3266);background:var(--bg,#0b0919);color:var(--text,#f3eefc)}.ds-cart-name{font-family:'IBM Plex Mono',ui-monospace,Menlo,monospace;font-size:12.5px;font-weight:500}.ds-cart-meta{font-family:'IBM Plex Mono',ui-monospace,Menlo,monospace;font-size:11px;color:var(--muted,#a69dc8);font-variant-numeric:tabular-nums}.ds-cart-dirty{display:inline-flex;align-items:center;gap:6px;font-family:'DM Sans',ui-sans-serif,system-ui,sans-serif;font-size:12px;font-weight:500;color:var(--accent-fg,#ff6bb7)}.ds-dot{width:6px;height:6px;background:var(--accent,#ff4fa8);animation:ds-blink 1.6s ease-in-out infinite}@keyframes ds-blink{50%{opacity:.35}}@media (prefers-reduced-motion:reduce){.ds-dot{animation:none}}"
