      "css": ".ds-stage{position:relative;height:200px;background:var(--sky,linear-gradient(180deg,#0b0919 0%,#160f33 48%,#35185a 78%,#8a2a78 100%))}.ds-hud{position:absolute;top:16px;right:20px;margin:0;display:grid;grid-template-columns:auto auto;column-gap:16px;row-gap:2px;text-align:right}.ds-hud dt{align-self:center;font-family:'IBM Plex Mono',ui-monospace,Menlo,monospace;font-size:10.5px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--faint,#7d74a6)}.ds-hud dd{margin:0;font-family:'Bricolage Grotesque','DM Sans',sans-serif;font-size:17px;line-height:22px;font-weight:600;letter-spacing:-.01em;font-variant-numeric:tabular-nums;color:var(--text,#f3eefc);text-shadow:0 1px 8px var(--bg,#0b0919)}"
