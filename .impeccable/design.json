      "css": ".ds-chip{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px;border:1px solid var(--line,#262046);background:transparent;color:var(--muted,#a69dc8);font-family:'DM Sans',ui-sans-serif,system-ui,sans-serif;font-size:12.5px;font-weight:500;border-radius:0;cursor:pointer;transition:background-color 120ms,border-color 120ms,color 120ms}.ds-chip[aria-pressed=true]{border-color:var(--line-strong,#3a3266);background:var(--panel-2,#18142f);color:var(--text,#f3eefc)}.ds-chip:focus-visible{outline:2px solid var(--accent-2,#3fd6f2);outline-offset:1px}.ds-sw{width:8px;height:8px;display:inline-block}"
