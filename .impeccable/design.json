      "css": ".ds-nav{display:flex;flex-direction:column;width:240px;background:var(--panel,#110e24)}.ds-nav-item{display:flex;align-items:center;gap:10px;height:32px;padding:0 16px;border:0;background:transparent;color:var(--muted,#a69dc8);font-family:'DM Sans',ui-sans-serif,system-ui,sans-serif;font-size:13px;font-weight:500;text-align:left;cursor:pointer;transition:background-color 120ms,color 120ms}.ds-nav-item[aria-pressed=true]{background:var(--panel-2,#18142f);color:var(--text,#f3eefc)}.ds-nav-item:hover:not([aria-pressed=true]){background:color-mix(in srgb,var(--panel-2,#18142f) 60%,transparent);color:var(--text,#f3eefc)}.ds-nav-item:focus-visible{outline:2px solid var(--accent-2,#3fd6f2);outline-offset:1px}"
